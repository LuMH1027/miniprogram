<view class="page-container">
  <view class="record-header"><view class="record-eyebrow">一起吃过的日常</view><view class="record-heading"><view class="record-title">我们的点单记录</view><view wx:if="{{totalOrderCount}}" class="record-count">{{totalOrderCount}} 单</view></view><view class="record-subtitle">那些想一起吃的，都记在这里。</view></view>
  <t-pull-down-refresh loading-props="{{loadingProps}}" value="{{pullDownRefreshing}}" loadingTexts="{{['下拉刷新', '松手刷新', '正在刷新', '刷新完成']}}" bind:refresh="pullRefresh">
    <view wx:for="{{orderList}}" wx:key="_id" wx:for-item="order" class="order-record-card" data-order="{{order}}" bindtap="onOrderCardTap" hover-class="record-pressed">
      <view class="record-top"><text class="record-date">{{order.createTimeText}}</text><text class="record-detail">查看详情 ›</text></view>
      <view class="record-content"><view wx:if="{{order.previewImages.length}}" class="record-photos"><image wx:for="{{order.previewImages}}" wx:for-item="photo" wx:key="*this" class="record-photo" src="{{photo}}" mode="aspectFill" lazy-load /></view><view class="record-description"><view class="record-name">{{order.itemSummary || '暂无商品'}}</view><view class="record-quantity">共 {{order.totalCount || 0}} 份</view></view></view>
      <view wx:if="{{order.remarkText !== '无备注'}}" class="record-remark">备注：{{order.remarkText}}</view>
      <view class="record-bottom"><text class="record-total-label">本次点单</text><price fill class="record-price" price="{{order.totalPrice * 100 + ''}}" decimalSmaller /></view>
    </view>
    <load-more list-is-empty="{{!orderList.length}}" status="{{listLoading}}" bind:retry="onReTryLoad" no-more-text="每一份喜欢，都有记录">
      <view slot="empty" class="empty-wrapper"><view class="empty-title">第一份喜欢，还在等你</view><view class="empty-subtitle">去挑点想吃的，留下我们的第一笔记录。</view><button class="empty-action" bindtap="goPickFood">去挑好吃的</button></view>
    </load-more>
  </t-pull-down-refresh>
</view>
<t-toast id="t-toast" />
<t-dialog id="t-dialog" />
