page { padding-bottom: calc(env(safe-area-inset-bottom) + 128rpx); }
.home-page-header, .home-page-container { padding: 0 28rpx; }
.welcome-card { position: relative; padding: 36rpx 32rpx; margin: 20rpx 0 24rpx; border-radius: 28rpx; background: #fce6ee; overflow: hidden; }
.welcome-eyebrow { color: #945269; font-size: 22rpx; letter-spacing: 3rpx; margin-bottom: 16rpx; }
.welcome-title { font-size: 44rpx; line-height: 1.4; font-weight: 700; color: #30282d; }
.welcome-subtitle { margin-top: 10rpx; color: #77616c; font-size: 26rpx; line-height: 40rpx; }
.welcome-action { display: inline-flex; align-items: center; margin-top: 26rpx; padding: 0 24rpx; height: 76rpx; border-radius: 38rpx; background: #c94e76; color: #fff; font-size: 26rpx; font-weight: 600; gap: 12rpx; }
.home-page-header .t-search__input-container { height: 80rpx !important; background: #fff !important; border: 1rpx solid #ecdee4; border-radius: 20rpx !important; }
.home-page-header .t-search__input { font-size: 26rpx !important; }
.quick-categories { display: grid; grid-template-columns: repeat(4, 1fr); margin: 24rpx 0 30rpx; gap: 12rpx; }
.quick-category { display: flex; flex-direction: column; align-items: center; height: auto; min-height: 128rpx; padding: 8rpx 0; font-size: 25rpx; color: #51434a; }
.quick-category__icon { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; background: #fff; border: 1rpx solid #f1e5ea; border-radius: 24rpx; color: #b24468; margin-bottom: 12rpx; }
.swiper-wrap { margin-bottom: 28rpx; border-radius: 24rpx; overflow: hidden; }
.home-section-heading { display: flex; align-items: center; justify-content: space-between; margin: 10rpx 0 24rpx; gap: 12rpx; }
.home-section-title { font-size: 31rpx; font-weight: 650; color: #30282d; }
.section-link { display: flex; align-items: center; min-height: 72rpx; font-size: 24rpx; color: #8a566b; flex-shrink: 0; }
.home-page-container .goods-list-container { background: transparent !important; }
.goods-skeleton { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.skeleton-card { border-radius: 24rpx; overflow: hidden; background: #fff; padding-bottom: 24rpx; }
.skeleton-photo { height: 270rpx; background: #f1e5ea; }
.skeleton-line { height: 24rpx; background: #f1e5ea; margin: 24rpx 20rpx 0; border-radius: 6rpx; }
.skeleton-line--short { width: 45%; margin-top: 16rpx; }
.home-empty { padding: 100rpx 20rpx; text-align: center; color: #776a72; }
.sweet-pressed { opacity: .75; transform: scale(.98); }
