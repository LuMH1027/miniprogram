<view class="goods-detail-page">
  <view class="goods-head">
    <t-swiper wx:if="{{details.images.length > 0}}" height="750rpx" current="{{current}}" autoplay="{{autoplay}}" duration="{{duration}}" interval="{{interval}}" navigation="{{navigation}}" list="{{details.images}}"></t-swiper>
    <view class="goods-info">
      <view class="goods-number">
        <view class="goods-price">
          <price wr-class="class-goods-price" symbol-class="class-goods-symbol" price="{{minSalePrice}}" type="lighter" />
          <view class="goods-price-up">起</view>
        </view>
      </view>
      <view class="goods-title">
        <view class="goods-name">{{details.title}}</view>
      </view>
    </view>
    <view class="quick-remark">
      <view class="quick-remark__title">备注快捷词</view>
      <view class="quick-remark__list">
        <view
          wx:for="{{quickRemarkOptions}}"
          wx:key="index"
          class="quick-remark__item {{selectedQuickRemark === item ? 'quick-remark__item--active' : ''}}"
          bindtap="onQuickRemarkTap"
          data-value="{{item}}"
        >
          {{item}}
        </view>
      </view>
      <view class="quick-remark__tip" wx:if="{{selectedQuickRemark}}">下单将自动带上：{{selectedQuickRemark}}</view>
    </view>
  </view>
  <view class="desc-content">
    <rich-text class="detail" nodes="{{detail}}" />
  </view>
  <view class="goods-bottom-operation">
    <buy-bar jumpArray="{{jumpArray}}" soldout="{{soldout}}" isStock="{{isStock}}" buttonType="{{buttonType}}" bind:toAddCart="toAddCart" bind:toNav="toNav" bind:toBuyNow="buyItNow" class="goods-details-card" />
  </view>
  <goods-specs-popup id="goodsSpecsPopup" initProps="{{descPopUpInitProps}}" show="{{isSpuSelectPopupShow}}" title="{{details.title || ''}}" bind:closeSpecsPopup="handlePopupHide" bind:addCart="addCart" bind:buyNow="gotoBuy" outOperateStatus="{{outOperateStatus}}" />
</view>
<t-toast id="t-toast" />
<view wx:if="{{loading}}">
  <loading-dialog show="{{loading}}" />
</view>
