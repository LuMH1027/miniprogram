page { background: #fff8fa; padding-bottom: calc(env(safe-area-inset-bottom) + 150rpx); }
.cart-heading { padding: 36rpx 32rpx 28rpx; }
.cart-eyebrow { color: #a05570; font-size: 23rpx; letter-spacing: 3rpx; margin-bottom: 14rpx; }
.cart-title { font-size: 40rpx; line-height: 1.45; font-weight: 700; color: #30282d; }
.cart-subtitle { font-size: 26rpx; color: #776a72; line-height: 40rpx; margin-top: 12rpx; }
.gap { height: 48rpx; }
.cart-remark-card { margin: 20rpx 28rpx; padding: 24rpx; border: 1rpx solid #f1e5ea; border-radius: 24rpx; background: #fff; }
.cart-remark-title { font-size: 29rpx; font-weight: 600; color: #30282d; margin-bottom: 18rpx; }
.cart-remark-input { --td-textarea-background-color: #fcf6f8; border-radius: 16rpx; }
