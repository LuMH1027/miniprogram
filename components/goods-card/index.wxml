<view id="{{independentID}}" class="goods-card" bind:tap="clickHandle" data-goods="{{ goods }}">
  <view class="goods-card__main">
    <view class="goods-card__thumb" bind:tap="clickThumbHandle">
      <t-image wx:if="{{ !!goods.cover_image }}" t-class="goods-card__img" src="{{ goods.cover_image }}" mode="aspectFill" lazy-load />
    </view>
    <view class="goods-card__body">
      <view class="goods-card__upper">
        <view wx:if="{{ goods.dishName || goods.name }}" class="goods-card__title">{{ goods.dishName || goods.name }}</view>
        <view class="goods-card__desc">{{ goods.dishDesc }}</view>
        <view wx:if="{{ goods.monthSales || goods.dishTags.length }}" class="goods-card__meta">
          <text wx:if="{{goods.monthSales}}">月售{{goods.monthSales}}</text>
          <text wx:if="{{goods.monthSales && goods.dishTags.length}}"> · </text>
          <text wx:if="{{goods.dishTags.length}}">{{goods.dishTags[0]}}</text>
        </view>
      </view>
      <view class="goods-card__down">
        <price wx:if="{{ goods.price }}" wr-class="spec-for-price" symbol-class="spec-for-symbol" symbol="{{currency}}" price="{{goods.price * 100}}" />
        <view class="goods-card__add-cart" id="{{independentID}}-cart" data-id="{{independentID}}" catchtap="addCartHandle">选规格</view>
      </view>
    </view>
  </view>
</view>
