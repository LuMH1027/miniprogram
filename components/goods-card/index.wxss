.goods-card { width: 100%; border-radius: 24rpx; overflow: hidden; background: #fff; border: 1rpx solid #f1e5ea; }
.goods-card__main { display: flex; flex-direction: column; width: 100%; }
.goods-card__thumb { width: 100%; height: 276rpx; background: #f7edf1; overflow: hidden; }
.goods-card__img { display: block; width: 100%; height: 100%; }
.goods-card__body { padding: 20rpx; min-width: 0; }
.goods-card__title { color: #30282d; font-size: 29rpx; font-weight: 600; line-height: 40rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.goods-card__desc { color: #776a72; font-size: 23rpx; line-height: 34rpx; height: 34rpx; margin-top: 6rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.goods-card__meta { margin-top: 12rpx; color: #846e79; font-size: 21rpx; line-height: 30rpx; }
.goods-card__down { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 16rpx; }
.goods-card__add-cart { display: flex; align-items: center; justify-content: center; min-width: 100rpx; min-height: 72rpx; padding: 0 16rpx; border-radius: 36rpx; color: #fff; background: #c94e76; font-size: 24rpx; font-weight: 600; }
.goods-card__add-cart:active { opacity: .78; }
.spec-for-price { color: #b83f67; font-size: 34rpx; font-weight: 700; white-space: nowrap; }
.spec-for-symbol { font-size: 23rpx; }
