page { background: #fff8fa; padding-bottom: calc(env(safe-area-inset-bottom) + 132rpx); }
.record-header { padding: 36rpx 32rpx 28rpx; }
.record-eyebrow { color: #a05570; font-size: 23rpx; letter-spacing: 3rpx; margin-bottom: 14rpx; }
.record-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.record-title { font-size: 40rpx; color: #30282d; font-weight: 700; line-height: 1.45; }
.record-count { padding: 8rpx 18rpx; background: #f9e4ec; border-radius: 24rpx; color: #a94365; font-size: 24rpx; flex-shrink: 0; }
.record-subtitle { margin-top: 12rpx; color: #776a72; font-size: 26rpx; line-height: 40rpx; }
.order-record-card { margin: 0 28rpx 20rpx; border-radius: 24rpx; background: #fff; border: 1rpx solid #f1e5ea; padding: 24rpx; }
.record-top, .record-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.record-top { padding-bottom: 20rpx; border-bottom: 1rpx solid #f4eaf0; }
.record-date { font-size: 24rpx; color: #776a72; }
.record-detail { font-size: 23rpx; color: #a64c6b; flex-shrink: 0; }
.record-content { display: flex; align-items: center; margin: 24rpx 0; gap: 20rpx; }
.record-photos { display: flex; flex-shrink: 0; gap: 8rpx; max-width: 284rpx; }
.record-photo { width: 88rpx; height: 96rpx; border-radius: 14rpx; background: #f7edf1; }
.record-description { flex: 1; min-width: 0; }
.record-name { font-size: 28rpx; color: #30282d; font-weight: 600; line-height: 40rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.record-quantity { margin-top: 8rpx; font-size: 23rpx; color: #776a72; }
.record-remark { padding: 14rpx 18rpx; background: #fcf6f8; border-radius: 12rpx; font-size: 24rpx; line-height: 36rpx; color: #776a72; word-break: break-all; margin-bottom: 20rpx; }
.record-bottom { border-top: 1rpx solid #f4eaf0; padding-top: 20rpx; }
.record-total-label { color: #776a72; font-size: 24rpx; }
.record-price { color: #b83f67; font-size: 36rpx; font-weight: 700; }
.empty-wrapper { text-align: center; padding: 110rpx 32rpx; }
.empty-title { color: #30282d; font-size: 34rpx; font-weight: 600; }
.empty-subtitle { margin-top: 18rpx; color: #776a72; font-size: 25rpx; line-height: 40rpx; }
.empty-action { width: 280rpx; height: 84rpx; line-height: 84rpx; margin: 32rpx auto 0; background: #c94e76; color: #fff; border-radius: 42rpx; font-size: 28rpx; }
.record-pressed { opacity: .8; }
