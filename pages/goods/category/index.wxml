<view class="wrap">
  <view class="category-header">
    <view class="category-title">今天想吃点什么呀</view>
    <view class="category-subtitle">选一个分类，马上开始点单</view>
  </view>

  <view class="category-list">
    <view
      wx:for="{{fixedCategories}}"
      wx:key="key"
      class="category-item"
      bindtap="onCategoryTap"
      data-cate-id="{{item.cateId}}"
    >
      <view class="category-item__name">{{item.title}}</view>
      <view class="category-item__hint">甜甜地安排一下</view>
    </view>
  </view>
  <t-toast id="t-toast" />
</view>
