page { background: #fff8fa; }
.goods-list-container { padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 40rpx); }
.menu-heading { margin: 8rpx 0 32rpx; }
.menu-title { color: #30282d; font-size: 40rpx; font-weight: 700; }
.menu-subtitle { color: #776a72; font-size: 25rpx; line-height: 38rpx; margin-top: 10rpx; }
.empty-wrap { padding: 120rpx 24rpx; text-align: center; color: #776a72; line-height: 44rpx; }
.goods-list-container .wr-goods-list { background: transparent !important; }
