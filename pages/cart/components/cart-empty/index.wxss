.cart-empty { padding: 80rpx 32rpx 120rpx; display: flex; flex-direction: column; align-items: center; background: transparent; text-align: center; }
.cart-empty .cart-img { width: 180rpx; height: 180rpx; margin-bottom: 28rpx; }
.cart-empty .tip { font-size: 28rpx; line-height: 44rpx; color: #776a72; margin-bottom: 32rpx; }
.cart-empty .btn { width: 280rpx; height: 84rpx; border-radius: 42rpx; text-align: center; line-height: 84rpx; color: #fff; background: #c94e76; font-size: 28rpx; font-weight: 600; }

.cart-empty__icon { width: 160rpx; height: 160rpx; display: flex; align-items: center; justify-content: center; border-radius: 80rpx; color: #b24468; background: #fce6ee; margin-bottom: 32rpx; }
