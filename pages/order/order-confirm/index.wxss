.order-sure {
  box-sizing: border-box;
  background: #fff8fb;
  padding: 20rpx 24rpx calc(env(safe-area-inset-bottom) + 136rpx);
  min-height: 100vh;
}

.order-sure .confirm-head-card {
  border-radius: 20rpx;
  background: #fff;
  padding: 22rpx 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 143, 177, 0.12);
  margin-bottom: 14rpx;
}

.order-sure .confirm-head-title {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #5a516d;
  font-weight: 600;
}

.order-sure .confirm-head-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #9a90b0;
}

.order-sure .section-card {
  margin-top: 14rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 143, 177, 0.1);
}

.order-sure .section-title {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #5f5578;
  font-weight: 600;
  padding: 20rpx 24rpx 6rpx;
}

.order-sure .wx-pay-cover {
  position: fixed;
  left: 0;
  bottom: 0;
  right: 0;
  z-index: 10;
  background: #fff;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -8rpx 24rpx rgba(255, 143, 177, 0.08);
}
.order-sure .wx-pay-cover .wx-pay {
  width: 100%;
  height: 100rpx;
  box-sizing: border-box;
  padding: 0rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-sure .wx-pay-cover .wx-pay .price {
  color: #ff8fb1;
  font-weight: bold;
  font-size: 63rpx;
  line-height: 88rpx;
}

.order-sure .wx-pay-cover .wx-pay .submit-btn {
  height: 80rpx;
  width: 240rpx;
  border-radius: 40rpx;
  background: linear-gradient(90deg, #ff93b5 0%, #f7a4c5 100%);
  color: #ffffff;
  line-height: 80rpx;
  font-weight: bold;
  font-size: 28rpx;
  text-align: center;
}
.order-sure .wx-pay-cover .wx-pay .btn-gray {
  background: #cccccc;
}

.order-wrapper .store-wrapper {
  width: 100%;
  height: 96rpx;
  box-sizing: border-box;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
  background-color: #ffffff;
}
.order-wrapper .store-wrapper .store-logo {
  margin-right: 16rpx;
}
.order-wrapper .goods-wrapper {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #9a90b0;
  background-color: transparent;
}
.goods-wrapper .goods-image {
  width: 176rpx;
  height: 176rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 16rpx;
}
.goods-wrapper .goods-content {
  flex: 1;
}

.goods-wrapper .goods-content .goods-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
  line-height: 40rpx;
  margin-bottom: 12rpx;
  color: #4f4566;
  margin-right: 16rpx;
}

.goods-wrapper .goods-content .goods-spec {
  color: #9a90b0;
}

.goods-wrapper .goods-right {
  min-width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.goods-right .goods-price {
  color: #ff8fb1;
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.goods-right .goods-num {
  text-align: right;
}

.order-sure .pay-detail {
  background-color: transparent;
  padding: 8rpx 24rpx 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.order-sure .remark-section {
  margin-top: 14rpx;
  background-color: #ffffff;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.order-sure .remark-title {
  color: #5f5578;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.order-sure .remark-source {
  margin: -6rpx 0 12rpx;
  font-size: 22rpx;
  color: #8f85a8;
}

.order-sure .remark-textarea {
  --td-textarea-background-color: #fff4f9;
  border-radius: 16rpx;
}

.order-sure .pay-detail .pay-item {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8f85a8;
}
.order-sure .pay-detail .pay-item .pay-item__right {
  color: #4f4566;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  max-width: 400rpx;
}
.order-sure .pay-detail .pay-item .pay-item__right .pay-remark {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  max-width: 400rpx;
  text-overflow: ellipsis;
  overflow: hidden;
}
.order-sure .pay-detail .pay-item .font-bold {
  font-weight: bold;
}
.order-sure .pay-detail .pay-item .primary {
  color: #fa4126;
}

.add-notes .add-notes__content {
  --td-textarea-background-color: #f5f5f5;
}

.add-notes .t-textarea__placeholder {
  color: #aeb3b7;
}

.add-notes .add-notes__textarea__font {
  font-size: 26rpx;
}
.add-notes .add-notes__textarea {
  margin-top: 32rpx;
}

.order-sure .add-notes .dialog__message {
  border-radius: 8rpx;
}

.order-sure .add-notes .dialog__button-cancel::after {
  border-right: 0;
}

.order-sure .amount-wrapper {
  width: 100%;
  box-sizing: border-box;
  background-color: #ffffff;
  padding: 0rpx 24rpx;
  height: 92rpx;
}

.order-sure .pay-amount {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: #333333;
  position: relative;
}
.order-sure .pay-amount::after {
  position: absolute;
  content: ' ';
  top: 0;
  left: 0;
  width: 200%;
  height: 200%;
  transform: scale(0.5);
  transform-origin: 0 0;
  border-top: 2rpx solid #f1dbe6;
}
.order-sure .pay-amount .order-num {
  color: #999999;
  padding-right: 8rpx;
}

.order-sure .pay-amount .total-price {
  font-size: 36rpx;
  color: #ff8fb1;
  font-weight: bold;
  padding-left: 8rpx;
}
