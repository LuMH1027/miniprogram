<view class="person-info">
  <t-cell-group>
    <t-cell title="头像" center="{{true}}" t-class-left="order-group__left">
      <t-image slot="note" src="{{personInfo.avatarUrl}}" t-class="avatarUrl" mode="aspectFill" />
    </t-cell>
    <t-cell title="昵称" note="{{personInfo.nickName}}" t-class="t-cell-class" t-class-left="order-group__left" />
    <t-cell title="性别" note="{{genderMap[personInfo.gender]}}" t-class="t-cell-class" t-class-left="order-group__left" />
    <t-cell bordered="{{false}}" title="手机号" note="{{personInfo.phoneNumber || '未绑定'}}" t-class="t-cell-class" t-class-left="order-group__left" />
  </t-cell-group>
</view>
