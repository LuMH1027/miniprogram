/* Shared palette: rose actions, neutral text, soft pink surfaces. */
page {
  --sweet-accent: #c94e76;
  --sweet-ink: #30282d;
  --sweet-muted: #776a72;
  --sweet-bg: #fff8fa;
  --sweet-line: #f1e5ea;
  --td-brand-color: #c94e76;
}

/* 主题定制 */
.t-input {
  --td-input-placeholder-text-color: #bbbbbb;
  --td-input-text-color: #333333;
}

.t-tab-bar {
  --td-tab-bar-color: #a7a1b8;
  --td-tab-bar-active-color: #c94e76;
}

.t-cascader {
  --td-cascader-active-color: #c94e76;
}

.t-switch {
  --td-switch-checked-color: #34c759;
}

.t-button {
  --td-button-font-weight: 500;
  --td-button-medium-font-size: 32rpx;
  --td-button-default-color: #fff;
  --td-button-default-bg-color: #c94e76;
  --td-button-default-border-color: #c94e76;
  --td-button-default-disabled-color: #fff;
  --td-button-default-disabled-bg: #cccccc;
  --td-button-default-disabled-border-color: #cccccc;
  --td-button-default-active-bg-color: #b94369;
  --td-button-default-active-border-color: #b94369;
}

.t-textarea {
  --td-textarea-placeholder-color: #bbb;
}

.t-checkbox {
  --td-checkbox-icon-checked-color: #c94e76;
}

.dialog__button-confirm {
  color: #c94e76 !important;
}

.dialog__button-cancel {
  color: #aeb3b7 !important;
}
