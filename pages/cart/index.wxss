:host {
  padding-bottom: 100rpx;
  background: #fff8fb;
}

.gap {
  height: 100rpx;
  width: 100%;
}

.cart-remark-card {
  margin: 16rpx 24rpx 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 143, 177, 0.1);
}

.cart-remark-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5f5578;
  margin-bottom: 10rpx;
}

.cart-remark-input {
  border-radius: 16rpx;
  background: #fff8fb;
}

.t-button {
  --td-button-default-color: #000;
  --td-button-primary-text-color: #ff8fb1;
}
